# Copy to supabase/secrets.env, fill in, then run:  npx supabase secrets set --env-file supabase/secrets.env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# any long random string (used to sign the OAuth state)
STATE_SECRET=
# where your frontend runs: http://localhost:5173 now, your real domain later
APP_URL=http://localhost:5173
# AI insights and report summaries
ANTHROPIC_API_KEY=
# optional: raises PageSpeed rate limits (Google Cloud > APIs > PageSpeed Insights API)
PAGESPEED_API_KEY=
# secret for the hourly scheduler call (any long random string)
CRON_SECRET=
# optional: emailing scheduled reports (resend.com)
RESEND_API_KEY=
REPORT_FROM_EMAIL=

# ---- Automatic Google Analytics (users never sign in with Google) ----
# Service account JSON from Google Cloud, as ONE line of base64 (PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\path\key.json")))
GA_SERVICE_ACCOUNT=
# Optional: your Analytics account number (analytics.google.com > Admin > Account settings). Empty = first account the service account can see
GA_ACCOUNT_ID=
# Optional: reporting time zone / currency of the properties that get created
GA_TIMEZONE=Europe/London
GA_CURRENCY=USD
# Max websites per user with automatic Analytics (Google also limits how many properties one Analytics account can hold)
MANAGED_GA_PER_USER=5

# ---- Daily free limits per user (0 = no limit). Saved results are free and never counted ----
QUOTA_RESEARCH_PER_DAY=5
QUOTA_KEYWORDS_PER_DAY=30
QUOTA_BACKLINKS_PER_DAY=5
# your own email(s), comma separated: never limited
ADMIN_EMAILS=
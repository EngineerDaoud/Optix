# Copy to supabase/secrets.env, fill in, then run:  npx supabase secrets set --env-file supabase/secrets.env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# any long random string (used to sign the OAuth state)
STATE_SECRET=
# where your frontend runs: http://localhost:5173 now, your real domain later
APP_URL=http://localhost:5173
# AI insights and report summaries
ANTHROPIC_API_KEY=
# optional: raises PageSpeed rate limits (Google Cloud > APIs > PageSpeed Insights API)
PAGESPEED_API_KEY=
# ---- Authority and keyword data (all free keys) ----
# Open PageRank (free key: sign in at keywordseverywhere.com/openpagerank, 30,000 domains a month. Old openpagerank.com keys no longer work. A free key only works from ONE IPv4 address set on your account page). It is the strongest part of the Authority score (40%). Without it Authority
# is built from weaker signals only and can look too low or too jumpy.
OPENPAGERANK_API_KEY=
# Serper.dev (free credits at serper.dev). Real Google positions for keywords and competitors.
SERPER_API_KEY=
# secret for the hourly scheduler call (any long random string)
CRON_SECRET=
# optional: emailing scheduled reports (resend.com)
RESEND_API_KEY=
REPORT_FROM_EMAIL=

# ---- Automatic Google Analytics (users never sign in with Google) ----
# Service account JSON from Google Cloud, as ONE line of base64 (PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\path\key.json")))
GA_SERVICE_ACCOUNT=
# Optional: your Analytics account number (analytics.google.com > Admin > Account settings). Empty = first account the service account can see
GA_ACCOUNT_ID=
# Optional: reporting time zone / currency of the properties that get created
GA_TIMEZONE=Europe/London
GA_CURRENCY=USD
# Max websites per user with automatic Analytics (Google also limits how many properties one Analytics account can hold)
MANAGED_GA_PER_USER=5

# ---- Daily free limits per user (0 = no limit). Saved results are free and never counted ----
QUOTA_RESEARCH_PER_DAY=5
QUOTA_KEYWORDS_PER_DAY=30
QUOTA_BACKLINKS_PER_DAY=5
# ---- AI Visibility (free) ----
# Gemini key (free, aistudio.google.com/apikey): runs the 2 Google AI engines (with Google Search sources, and without). Groq key (free, console.groq.com): runs the ChatGPT-style open model.
GEMINI_API_KEY=
GROQ_API_KEY=
# optional: Groq model for the ChatGPT-style engine (default openai/gpt-oss-120b, falls back to openai/gpt-oss-20b)
GROQ_MODEL=
# optional: parallel Groq calls. Keep 1 on the free plan (8K tokens/min), raise to 3 on a paid Groq plan
AIVIS_GROQ_PARALLEL=1
# questions asked per check (3-10). More questions = more accurate, but uses more of the free daily limit
AIVIS_PROMPTS=7
QUOTA_AIVIS_PER_DAY=5

# your own email(s), comma separated: never limited
ADMIN_EMAILS=